<%@ page pageEncoding="UTF-8" import="java.util.*,com.barber.util.Html" %>
<% List<Map<String,Object>> barbers=(List<Map<String,Object>>)request.getAttribute("barbers");String ctx=request.getContextPath(); %>
<div class="container-fluid overflow-hidden py-5"><div class="container"><div class="text-center mb-5"><h1 class="font-dancing-script text-primary">Choose with confidence</h1><h2>Our barbers</h2><p>Meet the professionals behind every appointment.</p></div><div class="row g-4 team">
<%for(var b:barbers){String photo=String.valueOf(b.get("photo_url"));if(photo.isBlank())photo=ctx+"/assets/public/img/team-1.jpg";else if(photo.startsWith("/"))photo=ctx+photo;%><div class="col-md-6 col-lg-4"><div class="team-item position-relative overflow-hidden h-100"><img class="img-fluid w-100" style="height:360px;object-fit:cover" src="<%=Html.e(photo)%>" alt="<%=Html.e(b.get("name"))%>"><div class="p-4 bg-light"><p class="text-primary fw-bold mb-1"><%=Html.e(b.get("specialties"))%></p><h3 class="h4"><%=Html.e(b.get("name"))%></h3><p><%=Html.e(b.get("bio"))%></p><a class="btn btn-primary" href="<%=ctx%>/book">Book this barber</a></div></div></div><%}%>
<%if(barbers.isEmpty()){%><div class="col-12"><div class="alert alert-info">Barber profiles will appear here after the administrator adds them.</div></div><%}%></div></div></div>
