<%@ page pageEncoding="UTF-8" import="java.util.*,java.time.*,com.barber.model.User,com.barber.util.Html,com.barber.service.BookingService" %>
<%!
 private String e(Object v){return Html.e(v);}
 private String input(String name,String label,Object value,String type){return "<div class=\"form-floating mb-3\"><input class=\"form-control\" id=\""+name+"\" name=\""+name+"\" type=\""+type+"\" value=\""+e(value)+"\" placeholder=\""+label+"\" required maxlength=\"200\""+(type.equals("password")?" minlength=\"12\" autocomplete=\"new-password\"":"")+"><label for=\""+name+"\">"+label+"</label></div>";}
%>
<% String pageName=(String)request.getAttribute("page"); String ctx=request.getContextPath(); String csrf=(String)session.getAttribute("csrf"); Object flash=session.getAttribute("flash"); session.removeAttribute("flash"); %>
<div class="container-fluid py-5"><div class="container"><div class="row justify-content-center"><div class="col-lg-9">
<% if(flash!=null){ %><div class="alert alert-info" role="status"><%=e(flash)%></div><% } %>
<% if("error".equals(pageName)){ Object code=request.getAttribute("errorCode");Object title=request.getAttribute("errorTitle");Object action=request.getAttribute("errorAction");Object actionLabel=request.getAttribute("errorActionLabel"); %>
<div class="card border-0 shadow-sm mx-auto overflow-hidden" style="max-width:760px"><div class="row g-0"><div class="col-md-4 bg-dark text-white d-flex flex-column justify-content-center align-items-center text-center p-5"><span class="display-1 fw-bold text-primary"><%=e(code==null?"!":code)%></span><span class="text-uppercase small">Request status</span></div><div class="col-md-8"><div class="card-body p-4 p-lg-5"><p class="text-primary text-uppercase fw-bold mb-2">Limpio Holič</p><h1 class="h2 mb-3"><%=e(title==null?"We could not complete that request":title)%></h1><p class="text-muted mb-4"><%=e(request.getAttribute("error"))%></p><div class="d-flex flex-wrap gap-2"><a href="<%=ctx%><%=e(action==null?"/home":action)%>" class="btn btn-primary"><%=e(actionLabel==null?"Return home":actionLabel)%></a><a href="<%=ctx%>/home" class="btn btn-outline-primary">Public site</a></div></div></div></div></div>
<% } else if("profile".equals(pageName)){ var profile=(Map<String,Object>)request.getAttribute("profile"); %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1>My profile</h1><p class="mb-0">Keep your contact details current for appointment updates.</p></div><a class="btn btn-outline-primary" href="<%=ctx%>/my-bookings">My appointments</a></div>
<form method="post" action="<%=ctx%>/profile" class="mx-auto" style="max-width:680px"><input type="hidden" name="csrf" value="<%=e(csrf)%>">
<%=input("name","Full name",profile.get("name"),"text")%><%=input("email","Email address",profile.get("email"),"email")%><%=input("phone","Mobile number",profile.get("phone"),"tel")%>
<div class="form-floating mb-3"><input class="form-control" id="password" name="password" type="password" placeholder="New password" minlength="12" maxlength="200" autocomplete="new-password"><label for="password">New password (optional)</label></div>
<p class="small">Leave the password blank to keep your existing password. New passwords require at least 12 characters.</p><button class="btn btn-primary w-100 py-3" type="submit">Save profile</button></form>
<% } else if("login".equals(pageName)||"register".equals(pageName)){ boolean register="register".equals(pageName); %>
<div class="text-center mb-5"><h1 class="font-dancing-script text-primary">Welcome to Barber</h1><h2><%=register?"Create your account":"Sign in"%></h2><p>Customers, barbers and administrators use this sign-in.</p></div>
<form method="post" action="<%=ctx%>/<%=pageName%>" class="mx-auto" style="max-width:560px">
<input type="hidden" name="csrf" value="<%=e(csrf)%>">
<% if(register){ %><%=input("name","Full name","","text")%><%=input("phone","Mobile number","","tel")%><% } %>
<%=input("email","Email address","","email")%>
<div class="form-floating mb-3"><input class="form-control" id="password" name="password" type="password" placeholder="Password" required minlength="12" maxlength="200" autocomplete="<%=register?"new-password":"current-password"%>"><label for="password">Password</label></div>
<p class="small">Use at least 12 characters. Your password is stored as a salted hash.</p>
<button class="btn btn-primary w-100 py-3" type="submit"><%=register?"Create account":"Sign in"%></button>
<p class="mt-4 text-center"><a href="<%=ctx%>/<%=register?"login":"register"%>"><%=register?"Already registered? Sign in":"New customer? Create an account"%></a></p></form>
<% } else if("book".equals(pageName)){ var services=(List<Map<String,Object>>)request.getAttribute("services");var barbers=(List<Map<String,Object>>)request.getAttribute("barbers");var addons=(List<Map<String,Object>>)request.getAttribute("addons");var previous=(Map<String,Object>)request.getAttribute("previous");long previousService=previous==null?0:((Number)previous.get("service_id")).longValue(),previousBarber=previous==null?0:((Number)previous.get("barber_id")).longValue();var previousAddons=previous==null?List.of():(List<Long>)previous.get("addons"); %>
<div class="text-center mb-5"><h1 class="font-dancing-script text-primary">Your next appointment</h1><h2>Choose your barber and time</h2><p>All times are Asia/Manila. Book up to 90 days ahead. Pay at the shop.</p></div>
<% if(services.isEmpty()||barbers.isEmpty()){ %><div class="alert alert-info">Online appointments are not available yet. The administrator must add an active barber, service and working hours.</div><% } else { %>
<form id="booking-form" method="post" action="<%=ctx%>/book" data-availability="<%=ctx%>/availability">
<input type="hidden" name="csrf" value="<%=e(csrf)%>">
<div class="row g-3"><div class="col-md-6"><label for="service" class="form-label">Service</label><select id="service" name="service" class="form-select py-3" required>
<% for(var s:services){long sid=((Number)s.get("id")).longValue(); %><option value="<%=sid%>" <%=sid==previousService?"selected":""%> data-price="<%=s.get("price")%>" data-minutes="<%=s.get("minutes")%>"><%=e(s.get("name"))%> — PHP <%=s.get("price")%> / <%=s.get("minutes")%> min</option><% } %></select></div>
<div class="col-md-6"><label for="barber" class="form-label">Barber</label><select id="barber" name="barber" class="form-select py-3" required><% for(var b:barbers){long bid=((Number)b.get("id")).longValue(); %><option value="<%=bid%>" <%=bid==previousBarber?"selected":""%>><%=e(b.get("name"))%><%if(!String.valueOf(b.get("specialties")).isBlank()){%> — <%=e(b.get("specialties"))%><%}%></option><% } %></select></div>
<div class="col-12"><fieldset class="border p-3"><legend class="float-none w-auto fs-6 px-2">Optional add-ons</legend><% for(var a:addons){long aid=((Number)a.get("id")).longValue(); %><label class="d-block mb-2"><input class="form-check-input me-2" type="checkbox" name="addon" value="<%=aid%>" <%=previousAddons.contains(aid)?"checked":""%> data-price="<%=a.get("price")%>" data-minutes="<%=a.get("minutes")%>"><%=e(a.get("name"))%> — PHP <%=a.get("price")%> / <%=a.get("minutes")%> min</label><% } %></fieldset></div>
<div class="col-md-6"><label for="date" class="form-label">Date</label><input class="form-control py-3" type="date" id="date" name="date" min="<%=BookingService.today()%>" max="<%=BookingService.today().plusDays(90)%>" value="<%=BookingService.today().plusDays(1)%>" required></div>
<div class="col-md-6"><label for="time" class="form-label">Available time</label><select class="form-select py-3" id="time" name="time" required><option value="">Loading availability…</option></select></div>
<div class="col-12"><div class="border rounded p-3 mb-3"><p class="fw-bold mb-2">Optional recurring schedule</p><div class="row g-2"><div class="col-md-6"><label for="occurrences" class="form-label">Number of appointments</label><select class="form-select" id="occurrences" name="occurrences"><option value="1">One appointment</option><option value="2">2 appointments</option><option value="3">3 appointments</option><option value="4">4 appointments</option><option value="6">6 appointments</option><option value="12">12 appointments</option></select></div><div class="col-md-6"><label for="intervalWeeks" class="form-label">Repeat every</label><select class="form-select" id="intervalWeeks" name="intervalWeeks"><option value="1">1 week</option><option value="2">2 weeks</option><option value="3" selected>3 weeks</option><option value="4">4 weeks</option></select></div></div><small>All occurrences must be available and fall within the 90-day booking window.</small></div><p id="booking-quote" class="fw-bold mb-2"></p><p id="availability-status" role="status" aria-live="polite"></p><button class="btn btn-primary w-100 py-3" id="confirm-booking" type="submit" disabled>Confirm appointment</button></div></div></form>
<hr class="my-5"><div class="card border-0 bg-light"><div class="card-body"><h3 class="h5">Preferred time fully booked?</h3><p>Join the queue for a specific time. If it is cancelled, the first waiting customer receives an in-app offer.</p><form method="post" action="<%=ctx%>/waitlist" class="row g-2"><input type="hidden" name="csrf" value="<%=e(csrf)%>"><div class="col-md-3"><select class="form-select" name="service" required><%for(var s:services){%><option value="<%=s.get("id")%>"><%=e(s.get("name"))%></option><%}%></select></div><div class="col-md-3"><select class="form-select" name="barber" required><%for(var b:barbers){%><option value="<%=b.get("id")%>"><%=e(b.get("name"))%></option><%}%></select></div><div class="col-md-2"><input class="form-control" type="date" name="date" min="<%=BookingService.today()%>" max="<%=BookingService.today().plusDays(90)%>" required></div><div class="col-md-2"><input class="form-control" type="time" name="time" step="1800" required></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Join waitlist</button></div></form></div></div>
<% } %>
<% } else if("my-bookings".equals(pageName)){ var rows=(List<Map<String,Object>>)request.getAttribute("bookings"); %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><h1>My appointments</h1><a class="btn btn-primary" href="<%=ctx%>/book">Book appointment</a></div><%long visits=(Long)request.getAttribute("loyaltyVisits");var notices=(List<Map<String,Object>>)request.getAttribute("notifications");var waiting=(List<Map<String,Object>>)request.getAttribute("waitlist");%><div class="alert alert-success"><strong>Digital loyalty card:</strong> <%=visits%6%> of 5 visits toward your next reward. <%if(visits%6==5){%>Your next eligible service is your reward visit.<%}else{%><%=5-(visits%6)%> more completed visit(s) to go.<%}%></div><%for(var n:notices){%><div class="alert alert-warning"><%=e(n.get("message"))%></div><%}%><p>Most recent 250 appointments. Times are Asia/Manila. Cancel upcoming confirmed appointments here.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reference</th><th>Service and barber</th><th>Appointment</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody>
<% for(var b:rows){ %><tr><td>#<%=b.get("id")%></td><td><%=e(b.get("description"))%><br><small><%=e(b.get("barber"))%></small></td><td><%=e(b.get("starts_at"))%><br><small>Until <%=e(b.get("ends_at"))%></small></td><td>PHP <%=b.get("total")%></td><td><span class="badge bg-secondary"><%=e(b.get("status"))%></span></td><td><a class="btn btn-outline-primary btn-sm mb-1" href="<%=ctx%>/rebook?id=<%=b.get("id")%>">Book same again</a><% if("CONFIRMED".equals(b.get("status"))&&((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().isAfter(LocalDateTime.now(BookingService.ZONE))){ %><form method="post" action="<%=ctx%>/cancel-booking" data-confirm="Cancel this appointment?"><input type="hidden" name="csrf" value="<%=e(csrf)%>"><input type="hidden" name="id" value="<%=b.get("id")%>"><button class="btn btn-outline-danger btn-sm">Cancel</button></form><% } %></td></tr><% } %>
<% if(rows.isEmpty()){ %><tr><td colspan="6" class="text-center py-5">No appointments yet. Choose a service to get started.</td></tr><% } %></tbody></table></div><%if(!waiting.isEmpty()){%><h2 class="h4 mt-5">My waitlist</h2><div class="table-responsive"><table class="table"><thead><tr><th>Service</th><th>Barber</th><th>Requested time</th><th>Status</th><th></th></tr></thead><tbody><%for(var w:waiting){%><tr><td><%=e(w.get("service"))%></td><td><%=e(w.get("barber"))%></td><td><%=w.get("requested_date")%> <%=w.get("requested_time")%></td><td><%=e(w.get("status"))%></td><td><%if("OFFERED".equals(w.get("status"))){%><form method="post" action="<%=ctx%>/claim-waitlist"><input type="hidden" name="csrf" value="<%=e(csrf)%>"><input type="hidden" name="id" value="<%=w.get("id")%>"><button class="btn btn-success btn-sm">Claim appointment</button></form><%}%></td></tr><%}%></tbody></table></div><%}%>
<% } %>
</div></div></div></div>
