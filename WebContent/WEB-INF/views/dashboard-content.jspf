<%@ page pageEncoding="UTF-8" import="java.util.*,java.time.*,java.math.BigDecimal,com.barber.model.User,com.barber.util.Html,com.barber.service.BookingService" %>
<%!
 private String e(Object v){return Html.e(v);}
 private String field(String n,Object value,String type){return "<input class=\"form-control\" aria-label=\""+n+"\" name=\""+n+"\" type=\""+type+"\" value=\""+e(value)+"\" required "+(type.equals("number")?"min=\"0\" step=\"0.01\"":"maxlength=\"200\"")+">";}
 private String hidden(Object token,Object id){return "<input type=\"hidden\" name=\"csrf\" value=\""+e(token)+"\"><input type=\"hidden\" name=\"id\" value=\""+e(id)+"\">";}
%>
<% String ctx=request.getContextPath();String section=(String)request.getAttribute("page");Object csrf=session.getAttribute("csrf");User current=(User)session.getAttribute("user");Object flash=session.getAttribute("flash");session.removeAttribute("flash"); %>
<div class="container-fluid pt-4 px-4"><% if(flash!=null){ %><div class="alert alert-info" role="status"><%=e(flash)%></div><% } %>
<h3 class="mb-4 text-capitalize"><%=e(section)%></h3>
<% if("dashboard".equals(section)||"bookings".equals(section)){ var rows=(List<Map<String,Object>>)request.getAttribute("bookings");
long today=rows.stream().filter(b->((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().toLocalDate().equals(BookingService.today())).count();
long upcoming=rows.stream().filter(b->"CONFIRMED".equals(b.get("status"))&&((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().isAfter(LocalDateTime.now(BookingService.ZONE))).count();
long completed=rows.stream().filter(b->"COMPLETED".equals(b.get("status"))).count();
BigDecimal total=rows.stream().filter(b->"COMPLETED".equals(b.get("status"))).map(b->(BigDecimal)b.get("total")).reduce(BigDecimal.ZERO,BigDecimal::add);
%>
<% if("dashboard".equals(section)){ %><div class="row g-4 mb-4">
<div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-calendar-day fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Today's appointments</p><h6 class="mb-0"><%=today%></h6></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-calendar-check fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Upcoming</p><h6 class="mb-0"><%=upcoming%></h6></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-check-circle fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Completed</p><h6 class="mb-0"><%=completed%></h6></div></div></div>
<div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-coins fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Completed value</p><h6 class="mb-0">PHP <%=total%></h6></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-sm-12 col-xl-6"><div class="bg-light text-center rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h6 class="mb-0">Appointments this week</h6><a href="<%=ctx%>/staff/bookings">Show All</a></div><canvas id="barber-week" aria-label="Appointments during the next seven days"></canvas></div></div><div class="col-sm-12 col-xl-6"><div class="bg-light text-center rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h6 class="mb-0">Completed service value</h6><a href="<%=ctx%>/staff/bookings">Show All</a></div><canvas id="barber-value" aria-label="Completed value during the last seven days"></canvas></div></div></div>
<% StringJoiner dates=new StringJoiner(","),counts=new StringJoiner(","),pastDates=new StringJoiner(","),values=new StringJoiner(",");for(int i=0;i<7;i++){LocalDate date=BookingService.today().plusDays(i);LocalDate past=BookingService.today().minusDays(6-i);dates.add("\""+date+"\"");pastDates.add("\""+past+"\"");counts.add(String.valueOf(rows.stream().filter(b->!"CANCELLED".equals(b.get("status"))&&((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().toLocalDate().equals(date)).count()));values.add(rows.stream().filter(b->"COMPLETED".equals(b.get("status"))&&((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().toLocalDate().equals(past)).map(b->(BigDecimal)b.get("total")).reduce(BigDecimal.ZERO,BigDecimal::add).toPlainString());}%>
<script type="application/json" id="barber-chart-data">{"dates":[<%=dates%>],"counts":[<%=counts%>],"pastDates":[<%=pastDates%>],"values":[<%=values%>]}</script>
<% } %>
<div class="bg-light text-center rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h6 class="mb-0">Appointments</h6><a href="<%=ctx%>/dashboard">Refresh</a></div><p class="text-start small">Most recent 250 records <%=current.role().equals("BARBER")?"assigned to you":"across the shop"%>. Summary cards and charts cover this list; completed value is not a payment ledger. Times: Asia/Manila.</p>
<input class="form-control mb-3" id="table-search" aria-label="Filter appointments" placeholder="Filter by customer, barber, service or reference">
<div class="table-responsive"><table class="table text-start align-middle table-bordered table-hover mb-0"><thead><tr class="text-dark"><th>Reference</th><th>Customer</th><th>Barber and service</th><th>Appointment</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody id="booking-rows">
<% for(var b:rows){String status=(String)b.get("status");%><tr><td>#<%=b.get("id")%></td><td><%=e(b.get("customer"))%><br><small><%=e(b.get("customer_email"))%></small></td><td><%=e(b.get("barber"))%><br><small><%=e(b.get("description"))%></small></td><td><%=e(b.get("starts_at"))%></td><td>PHP <%=b.get("total")%></td><td><%=e(status)%></td><td><% if(Set.of("CONFIRMED","IN_PROGRESS").contains(status)){%><form method="post" action="<%=ctx%>/staff/status"><%=hidden(csrf,b.get("id"))%><select class="form-select form-select-sm mb-2" aria-label="New status" name="status"><% if(status.equals("CONFIRMED")){%><option value="IN_PROGRESS">Start service</option><option value="CANCELLED">Cancel</option><%}else{%><option value="COMPLETED">Complete</option><%}%></select><button class="btn btn-sm btn-primary">Update</button></form><%}%></td></tr><% } %>
<% if(rows.isEmpty()){%><tr><td colspan="7" class="py-5 text-center">No appointments to show.</td></tr><%}%></tbody></table></div></div>
<% if("dashboard".equals(section)){var next=rows.stream().filter(b->"CONFIRMED".equals(b.get("status"))&&((java.sql.Timestamp)b.get("starts_at")).toLocalDateTime().isAfter(LocalDateTime.now(BookingService.ZONE))).sorted(Comparator.comparing(b->(java.sql.Timestamp)b.get("starts_at"))).limit(4).toList();%>
<div class="row g-4 mt-1"><div class="col-sm-12 col-md-6 col-xl-4"><div class="h-100 bg-light rounded p-4"><div class="d-flex align-items-center justify-content-between mb-2"><h6 class="mb-0">Next appointments</h6><a href="<%=ctx%>/staff/bookings">Show All</a></div><%for(var b:next){%><div class="d-flex align-items-center border-bottom py-3"><img class="rounded-circle flex-shrink-0" src="<%=ctx%>/assets/dashboard/img/user.jpg" alt="" style="width:40px;height:40px"><div class="w-100 ms-3"><h6 class="mb-0"><%=e(b.get("customer"))%></h6><small><%=e(b.get("starts_at"))%></small><br><span><%=e(b.get("description"))%></span></div></div><%}if(next.isEmpty()){%><p class="py-3">No upcoming appointments.</p><%}%></div></div>
<div class="col-sm-12 col-md-6 col-xl-4"><div class="h-100 bg-light rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h6 class="mb-0">Calendar</h6><a href="<%=ctx%>/staff/bookings">Show All</a></div><div id="calender"></div><p class="small mt-3">Calendar reference only. Manage availability in Schedules.</p></div></div>
<div class="col-sm-12 col-md-6 col-xl-4"><div class="h-100 bg-light rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h6 class="mb-0">Shift checklist</h6><a href="<%=ctx%>/staff/bookings">Show All</a></div><%for(String task:List.of("Review today's appointments","Confirm your working hours","Prepare tools and station","Update completed services")){%><label class="d-flex align-items-center border-bottom py-3"><input class="form-check-input m-0" type="checkbox"><span class="w-100 ms-3"><%=task%></span></label><%}%><p class="small mt-3">Personal checklist; resets on page reload.</p></div></div></div><% } %>
<% } else if("customers".equals(section)){var items=(List<Map<String,Object>>)request.getAttribute("items");%>
<div class="bg-light rounded p-4"><div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h6 class="mb-1">Client directory</h6><p class="small mb-0">Registered customer contact details and appointment history summary.</p></div><input class="form-control" id="table-search" style="max-width:320px" aria-label="Filter customers" placeholder="Search customers"></div><div class="table-responsive"><table class="table text-start align-middle table-bordered table-hover"><thead><tr><th>Name</th><th>Contact</th><th>Joined</th><th>Bookings</th><th>Completed</th><th>Last appointment</th><th>Status</th></tr></thead><tbody id="booking-rows"><%for(var c:items){%><tr><td><%=e(c.get("name"))%></td><td><%=e(c.get("email"))%><br><small><%=e(c.get("phone"))%></small></td><td><%=e(c.get("created_at"))%></td><td><%=c.get("booking_count")%></td><td><%=c.get("completed_count")%></td><td><%=e(c.get("last_booking"))%></td><td><span class="badge <%=Boolean.TRUE.equals(c.get("active"))?"bg-success":"bg-secondary"%>"><%=Boolean.TRUE.equals(c.get("active"))?"Active":"Inactive"%></span></td></tr><%}%><%if(items.isEmpty()){%><tr><td colspan="7" class="text-center py-5">No registered customers.</td></tr><%}%></tbody></table></div></div>
<% } else if("services".equals(section)||"addons".equals(section)){var items=(List<Map<String,Object>>)request.getAttribute("items");String action=section.equals("services")?"service":"addon";%>
<div class="bg-light rounded p-4 mb-4"><h6 class="mb-4">Add <%=action%></h6><form class="row g-3" method="post" action="<%=ctx%>/admin/<%=action%>"><%=hidden(csrf,"")%><div class="col-md-4"><label class="form-label">Name</label><%=field("name","","text")%></div><div class="col-md-2"><label class="form-label">Minutes</label><%=field("minutes",30,"number")%></div><div class="col-md-2"><label class="form-label">Price PHP</label><%=field("price","0.00","number")%></div><div class="col-md-2"><label class="form-check mt-4"><input type="checkbox" class="form-check-input" name="active" checked>Active</label></div><div class="col-md-2"><button class="btn btn-primary mt-4">Add</button></div></form></div>
<div class="bg-light rounded p-4"><h6 class="mb-4">Edit catalog</h6><p>Deactivate an item to hide it from new bookings. Existing appointment details are retained.</p><%for(var a:items){%><form class="row g-3 mb-3 border-bottom pb-3" method="post" action="<%=ctx%>/admin/<%=action%>"><%=hidden(csrf,a.get("id"))%><div class="col-md-4"><%=field("name",a.get("name"),"text")%></div><div class="col-md-2"><%=field("minutes",a.get("minutes"),"number")%></div><div class="col-md-2"><%=field("price",a.get("price"),"number")%></div><div class="col-md-2"><label><input type="checkbox" class="form-check-input" name="active" <%=Boolean.TRUE.equals(a.get("active"))?"checked":""%>> Active</label></div><div class="col-md-2"><button class="btn btn-primary">Save</button></div></form><%}%></div>
<% }else if("barbers".equals(section)){var items=(List<Map<String,Object>>)request.getAttribute("items");%>
<div class="bg-light rounded p-4 mb-4"><h6 class="mb-4">Add barber account</h6><form class="row g-3" method="post" action="<%=ctx%>/admin/barber"><%=hidden(csrf,"")%><div class="col-md-4"><label class="form-label">Name</label><%=field("name","","text")%></div><div class="col-md-4"><label class="form-label">Email</label><%=field("email","","email")%></div><div class="col-md-4"><label class="form-label">Initial password</label><input class="form-control" name="password" type="password" required minlength="12" maxlength="200" autocomplete="new-password"></div><div class="col-12"><label class="me-3"><input class="form-check-input" type="checkbox" name="active" checked> Active</label><button class="btn btn-primary">Create barber</button></div></form></div>
<div class="bg-light rounded p-4"><h6>Edit barbers and public profiles</h6><p class="small">Leave the password blank to keep it. A barber with upcoming appointments cannot be deactivated.</p><%for(var b:items){%><div class="border-bottom pb-4 mb-4"><form class="row g-3 mb-3" method="post" action="<%=ctx%>/admin/barber"><%=hidden(csrf,b.get("id"))%><div class="col-md-3"><%=field("name",b.get("name"),"text")%></div><div class="col-md-3"><%=field("email",b.get("email"),"email")%></div><div class="col-md-3"><input class="form-control" name="password" type="password" placeholder="New password (optional)" aria-label="New password" minlength="12" maxlength="200" autocomplete="new-password"></div><div class="col-md-3"><label class="me-2"><input class="form-check-input" type="checkbox" name="active" <%=Boolean.TRUE.equals(b.get("active"))?"checked":""%>> Active</label><button class="btn btn-primary">Save account</button></div></form><form class="row g-3" method="post" action="<%=ctx%>/admin/barber-profile"><%=hidden(csrf,b.get("id"))%><div class="col-md-4"><input class="form-control" name="specialties" value="<%=e(b.get("specialties"))%>" maxlength="300" placeholder="Specialties, e.g. fades, beard design"></div><div class="col-md-5"><textarea class="form-control" name="bio" maxlength="800" placeholder="Short public biography"><%=e(b.get("bio"))%></textarea></div><div class="col-md-3"><input class="form-control mb-2" name="photoUrl" value="<%=e(b.get("photo_url"))%>" maxlength="500" placeholder="/assets/... or https://"><button class="btn btn-outline-primary">Save public profile</button></div></form></div><%}%></div>
<% }else if("schedules".equals(section)){var barbers=(List<Map<String,Object>>)request.getAttribute("barbers");var schedules=(List<Map<String,Object>>)request.getAttribute("schedules");var exceptions=(List<Map<String,Object>>)request.getAttribute("exceptions");%>
<p>Hours use Asia/Manila time. Bookings start every 30 minutes from opening. Schedule changes affect new bookings only.</p>
<div class="row g-4"><div class="col-xl-6"><div class="bg-light rounded p-4"><h6 class="mb-4">Weekly hours</h6><form method="post" action="<%=ctx%>/admin/schedule"><%=hidden(csrf,"")%><label class="form-label">Barber</label><select class="form-select mb-3" name="barber" required><%for(var b:barbers){%><option value="<%=b.get("id")%>"><%=e(b.get("name"))%></option><%}%></select><label class="form-label">Weekday</label><select class="form-select mb-3" name="weekday"><%for(DayOfWeek d:DayOfWeek.values()){%><option value="<%=d.getValue()%>"><%=d%></option><%}%></select><label>Opens</label><%=field("start","09:00","time")%><label class="mt-2">Closes</label><%=field("end","18:00","time")%><label class="my-3"><input type="checkbox" class="form-check-input" name="active" checked> Working day</label><button class="btn btn-primary d-block">Save hours</button></form></div></div>
<div class="col-xl-6"><div class="bg-light rounded p-4"><h6 class="mb-4">Date exception</h6><form method="post" action="<%=ctx%>/admin/exception"><%=hidden(csrf,"")%><label class="form-label">Barber</label><select class="form-select mb-3" name="barber" required><%for(var b:barbers){%><option value="<%=b.get("id")%>"><%=e(b.get("name"))%></option><%}%></select><label>Date</label><%=field("date",BookingService.today().plusDays(1),"date")%><label class="my-3"><input type="checkbox" class="form-check-input" name="closed" checked> Closed all day</label><div class="row g-2"><div class="col"><label>Opens if not closed</label><%=field("start","09:00","time")%></div><div class="col"><label>Closes</label><%=field("end","18:00","time")%></div></div><label class="my-3"><input type="checkbox" class="form-check-input" name="remove"> Remove exception and use weekly hours</label><button class="btn btn-primary d-block">Save exception</button></form></div></div></div>
<div class="bg-light rounded p-4 mt-4 table-responsive"><h6>Weekly schedules</h6><table class="table"><thead><tr><th>Barber</th><th>Day</th><th>Opens</th><th>Closes</th><th>Working</th></tr></thead><tbody><%for(var w:schedules){%><tr><td><%=e(w.get("name"))%></td><td><%=DayOfWeek.of(((Number)w.get("weekday")).intValue())%></td><td><%=w.get("start_time")%></td><td><%=w.get("end_time")%></td><td><%=w.get("active")%></td></tr><%}%></tbody></table><h6>Date exceptions</h6><table class="table"><thead><tr><th>Barber</th><th>Date</th><th>Closed</th><th>Opens</th><th>Closes</th></tr></thead><tbody><%for(var x:exceptions){%><tr><td><%=e(x.get("name"))%></td><td><%=x.get("day")%></td><td><%=x.get("closed")%></td><td><%=e(x.get("start_time"))%></td><td><%=e(x.get("end_time"))%></td></tr><%}%></tbody></table></div>
<% } %></div>
